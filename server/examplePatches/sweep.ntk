{"widgets":[{"wid":"n8","active":true,"activeOut":false,"hwActive":false,"smoothing":false,"easing":false,"inlets":[{"name":"in","mapping":"out"}],"outlets":[{"name":"out"}],"inputMapping":"out","outputMapping":null,"in":"# Sweep example: Tween→Servo\n\nThis example demonstrates using the Tween widget to sweep a servo where it moves from position 0 to position 180 and back over about 4 seconds, looping forever. Look at the settings in the Tween widget to see how to do this, including the easing.\n\nTo run this example:\n\n* Set the correct **ip address** in the Servo widget more panel\n* Check the **loop checkbox** in the Tween more panel\n* Check the  Servo **output checkbox** on the top right to connect to the device on the pin specified (D7)","out":0,"inputFloor":0,"outputFloor":0,"inputCeiling":1023,"outputCeiling":1023,"invert":false,"ins":[{"title":"in","to":"in"},{"title":"X Position","to":"left"},{"title":"Y Position","to":"top"},{"title":"opacity","to":"opacity"}],"outs":[{"title":"out","from":"in","to":"out1"}],"typeID":"Text","title":"Text","activeControlParameter":"left","controlParameters":[{"name":"X","parameter":"left"},{"name":"Y","parameter":"top"},{"name":"opacity","parameter":"opacity"}],"appendText":false,"left":100,"top":387,"opacity":100,"displayWidth":532,"displayHeight":271,"displayFont":"Arial, Helvetica, sans-serif","displayFontSize":"18px","displayFontColor":"#000000","displayFontItalic":false,"displayFontBold":false,"displayClass":"displaytext","displayClassLast":"displaytext","renderMarkdown":true,"displayVisible":true,"out1":"# Sweep example: Tween→Servo\n\nThis example demonstrates using the Tween widget to sweep a servo where it moves from position 0 to position 180 and back over about 4 seconds, looping forever. Look at the settings in the Tween widget to see how to do this, including the easing.\n\nTo run this example:\n\n* Set the correct **ip address** in the Servo widget more panel\n* Check the **loop checkbox** in the Tween more panel\n* Check the  Servo **output checkbox** on the top right to connect to the device on the pin specified (D7)","displayText":"# Sweep example: Tween→Servo\n\nThis example demonstrates using the Tween widget to sweep a servo where it moves from position 0 to position 180 and back over about 4 seconds, looping forever. Look at the settings in the Tween widget to see how to do this, including the easing.\n\nTo run this example:\n\n* Set the correct **ip address** in the Servo widget more panel\n* Check the **loop checkbox** in the Tween more panel\n* Check the  Servo **output checkbox** on the top right to connect to the device on the pin specified (D7)","offsetLeft":118,"offsetTop":381,"width":148,"height":152},{"wid":"n17","active":true,"activeOut":false,"hwActive":false,"smoothing":false,"easing":false,"inlets":[{"name":"in","mapping":"out"}],"outlets":[{"name":"out"}],"inputMapping":"out","outputMapping":null,"in":"--","out":0,"inputFloor":0,"outputFloor":0,"inputCeiling":1023,"outputCeiling":1023,"invert":false,"ins":[{"title":"in","to":"in"},{"title":"Duration","to":"duration"},{"title":"Start","to":"start"},{"title":"End","to":"end"}],"outs":[{"title":"out1","from":"output","to":"out1"}],"typeID":"Tween","title":"Tween","output":15.339079363859867,"duration":"1350","start":0,"end":"180","returnToStart":true,"loop":true,"playSequence":false,"threshold":512,"animationRunning":true,"lastInput":null,"userSequence":"0,500,500\n500,100,1000\n100,1000,500\n1000,0,500","sequencePosition":0,"tweenEasing":"easeOutQuad","gamma":2.8,"out1":15.339079363859867,"offsetLeft":120,"offsetTop":50,"width":148,"height":152},{"wid":"n18","active":true,"activeOut":false,"hwActive":false,"smoothing":false,"easing":false,"inlets":[{"name":"in","mapping":"out"}],"outlets":[{"name":"out"}],"inputMapping":"out","outputMapping":"D7","in":15.339079363859867,"out":15.339079363859867,"inputFloor":0,"outputFloor":0,"inputCeiling":1023,"outputCeiling":1023,"invert":false,"ins":[{"title":"in