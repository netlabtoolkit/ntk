{"widgets":[{"wid":"n8","active":true,"activeOut":false,"hwActive":false,"smoothing":false,"easing":false,"inlets":[{"name":"in","mapping":"out"}],"outlets":[{"name":"out"}],"inputMapping":"out","outputMapping":null,"in":"# Fade example: DigitalIn->Tween→AnalogOut\n\nThis example demonstrates using the tween widget to fade an LED up and down over about 3 seconds. Look at the more settings in the tween widget to see how to do this. \n\nTo run this example\n* Connect the DigitalIn widget to a switch with the correct port\n* Make the DigitalIn value go high (above 512) to trigger and start the Tween widget\n* Open the more panel of the Tween widget and check the loop checkbox\n* Set the correct ip address in the AnalogOut widget more panel\n* Check the  AnalogOut output checkbox on the top right to connect to the device on the pin specified (D7)","out":0,"inputFloor":0,"outputFloor":0,"inputCeiling":1023,"outputCeiling":1023,"invert":false,"ins":[{"title":"in","to":"in"},{"title":"X Position","to":"left"},{"title":"Y Position","to":"top"},{"title":"opacity","to":"opacity"}],"outs":[{"title":"out","from":"in","to":"out1"}],"typeID":"Text","title":"Text","activeControlParameter":"left","controlParameters":[{"name":"X","parameter":"left"},{"name":"Y","parameter":"top"},{"name":"opacity","parameter":"opacity"}],"appendText":false,"left":98,"top":357,"opacity":100,"displayWidth":530,"displayHeight":384,"displayFont":"Arial, Helvetica, sans-serif","displayFontSize":"18px","displayFontColor":"#000000","displayFontItalic":false,"displayFontBold":false,"displayClass":"displaytext","displayClassLast":"displaytext","renderMarkdown":true,"displayVisible":true,"out1":"# Fade example: DigitalIn->Tween→AnalogOut\n\nThis example demonstrates using the tween widget to fade an LED up and down over about 3 seconds. Look at the more settings in the tween widget to see how to do this. \n\nTo run this example\n* Connect the DigitalIn widget to a switch with the correct port\n* Make the Digi